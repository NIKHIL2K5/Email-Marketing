    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE public.campaigns\nSET status = 'running',\n    started_at = COALESCE(started_at, NOW()),\n    updated_at = NOW()\nWHERE status = 'scheduled'\n  AND scheduled_at IS NOT NULL\n  AND scheduled_at <= NOW()\n  AND (\n    {{ $('Production Send Configuration').first().json.campaign_id }} = 0\n    OR id = {{ $('Production Send Configuration').first().json.campaign_id }}\n  );\n\nSELECT c.id, c.campaign_key, c.name, c.status, c.scheduled_at, c.batch_size,\n       c.emails_per_minute, c.emails_per_hour, c.emails_per_day,\n       c.max_concurrency, c.max_retries, c.retry_backoff_seconds,\n       c.from_name, c.from_email, c.reply_to, c.subject\nFROM (\n  SELECT campaign_id FROM public.get_next_due_campaign()\n  UNION ALL\n  SELECT {{ $('Production Send Configuration').first().json.campaign_id }}::bigint\n  WHERE {{ $('Production Send Configuration').first().json.campaign_id }} > 0\n) active_ref\nJOIN public.campaigns c ON c.id = active_ref.campaign_id\nLIMIT 1;",
        "options": {}
      },
