    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    cr.id AS recipient_id,\n    cr.campaign_id,\n    cr.contact_id,\n    cr.email_normalized,\n    cr.attempt_count,\n    c.first_name,\n    c.last_name,\n    c.company,\n    c.title,\n    c.industry,\n    ca.campaign_key,\n    ca.from_name,\n    ca.from_email,\n    ca.reply_to,\n    REPLACE(\n      REPLACE(\n        REPLACE(\n          REPLACE(\n            REPLACE(\n              COALESCE(tv.subject, ca.subject),\n              CHR(123)||CHR(123)||'first_name'||CHR(125)||CHR(125), CHR(123)||CHR(123)||' .Tx.Data.first_name '||CHR(125)||CHR(125)\n            ),\n            CHR(123)||CHR(123)||'last_name'||CHR(125)||CHR(125), CHR(123)||CHR(123)||' .Tx.Data.last_name '||CHR(125)||CHR(125)\n          ),\n          CHR(123)||CHR(123)||'company'||CHR(125)||CHR(125), CHR(123)||CHR(123)||' .Tx.Data.company '||CHR(125)||CHR(125)\n        ),\n        CHR(123)||CHR(123)||'title'||CHR(125)||CHR(125), CHR(123)||CHR(123)||' .Tx.Data.title '||CHR(125)||CHR(125)\n      ),\n      CHR(123)||CHR(123)||'industry'||CHR(125)||CHR(125), CHR(123)||CHR(123)||' .Tx.Data.industry '||CHR(125)||CHR(125)\n    ) AS subject,\n    tv.listmonk_template_id AS template_id,\n    COALESCE(tv.html_content, '') AS body_html\nFROM public.campaign_recipients cr\nJOIN public.contacts c ON c.id = cr.contact_id\nJOIN public.campaigns ca ON ca.id = cr.campaign_id\nLEFT JOIN public.template_versions tv ON tv.id = ca.template_version_id\nWHERE cr.id = {{ $('Claim One Send Slot').first().json.recipient_id }}\nLIMIT 1;",
        "options": {}
      },
